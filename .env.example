# Embedding
EMBEDDING_PROVIDER=openai
# Legacy workspace fallback; initialized workspaces keep this profile in amrb.toml.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Optional compatibility alias for embedding credentials.
OPENAI_API_KEY=

# Qdrant connection. Collection and local storage paths belong in amrb.toml.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_DASHBOARD_URL=

# Hindsight user service (OpenAI-compatible LLM)
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_BASE_URL=

# RAG
RAG_TOP_K=8
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100

# Optional: official infrastructure UIs for debugging
HINDSIGHT_UI_URL=
