# Embedding
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Optional: used if Hindsight is configured with its OpenAI provider.
OPENAI_API_KEY=

# Qdrant
QDRANT_PATH=.state/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=agent_memory_papers

# RAG
RAG_TOP_K=8
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
